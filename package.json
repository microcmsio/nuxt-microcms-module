{
  "name": "nuxt-microcms-module",
  "version": "3.1.1",
  "description": "microCMS integration for Nuxt.js",
  "keywords": [
    "nuxt",
    "module",
    "nuxt-module",
    "microcms",
    "headless",
    "cms"
  ],
  "homepage": "https://github.com/microcmsio/nuxt-microcms-module#readme",
  "bugs": {
    "url": "https://github.com/microcmsio/nuxt-microcms-module/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microcmsio/nuxt-microcms-module.git"
  },
  "license": "Apache-2.0",
  "author": "shibe97",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxi prepare playground",
    "lint": "eslint .",
    "prepublishOnly": "nuxi prepare playground && npm run lint && nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.2",
    "microcms-js-sdk": "^3.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "nuxt": "^4.6.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "npm": ">=12.0.0"
  },
  "packageManager": "npm@12.2.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
